# TrustLens AI Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
MAX_PDF_PAGES=10

# AI Provider Configuration - Gemma 4
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL_ID=gemma-4-31b-it
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=45
GEMMA_MAX_RETRIES=1

# Cloudways Production Deployment (Optional/Remote)
CLOUDWAYS_SERVER_IP=
CLOUDWAYS_SSH_USER=
